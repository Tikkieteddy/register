# ---------- Dependencies ----------
node_modules/
.pnp/
.pnp.js
.yarn/
vendor/

# ---------- Environment / ความลับ ----------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---------- Build output ----------
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
.turbo/
.vercel/
.wrangler/
*.tsbuildinfo

# ---------- ข้อมูลผู้ลงทะเบียนจริง (ห้าม commit เด็ดขาด - PDPA) ----------
data/
exports/
backups/
uploads/
*.xlsx
*.csv
!docs/**/*.csv
registrations-*.json
attendees-*.*

# ---------- Log / cache / temp ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.cache/
coverage/
.nyc_output/
tmp/
temp/

# ---------- Test artifacts ----------
playwright-report/
test-results/
k6-results/

# ---------- OS / Editor ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ฐานข้อมูลทดสอบในเครื่อง (ไม่ commit)
.env.local

# ผลลัพธ์การทดสอบ
tests/*.png

# ไฟล์ภาพที่อัปโหลดตอนพัฒนา — ห้ามขึ้น Git
/public/uploads/

# ---------- เอกสารสรุปที่สร้างขึ้นใหม่ได้ ----------
# ไฟล์ PDF สรุประบบสร้างใหม่ได้ตลอดจากโค้ดและภาพหน้าจอ
# ขนาดหลายเมกะไบต์ ถ้า commit ทุกครั้งที่สร้างใหม่ repo จะบวมเร็วมาก
# (ทำตามแนวเดียวกับ exports/ และ *.xlsx ที่กันไว้อยู่แล้วด้านบน)
*.pdf
.shots/
