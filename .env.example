# ==============================================================================
# ตัวอย่างการตั้งค่า environment variables
#
# วิธีใช้: คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง
#   Windows PowerShell:  Copy-Item .env.example .env.local
#   macOS / Linux:       cp .env.example .env.local
#
# ⚠️ ห้าม commit ไฟล์ .env หรือ .env.local เข้า git เด็ดขาด (.gitignore กันไว้แล้ว)
# ==============================================================================

# ------------------------------------------------------------------------------
# ฐานข้อมูล (จำเป็น)
# ------------------------------------------------------------------------------
# Connection string ของ PostgreSQL
# หาได้จาก Supabase → Project Settings → Database → Connection string → URI
# ⚠️ ต้องเลือก region Singapore (ap-southeast-1) เพื่อให้ผู้ใช้ในไทยเข้าถึงได้เร็ว
# ⚠️ ใช้ Connection pooling (พอร์ต 6543) สำหรับ production เพื่อรองรับ serverless
# ⚠️ ต้องเป็นเส้น "Transaction pooler" พอร์ต 6543 เท่านั้น
#    ถ้าใช้พอร์ต 5432 บน Vercel จะเปิด connection เต็มโควตาแล้วเว็บล่มตอนคนเข้าพร้อมกัน
DATABASE_URL="postgresql://postgres.xxxxx:รหัสผ่าน@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# เส้น "Session mode" พอร์ต 5432 ที่ Supabase ให้มาคู่กัน
# ⚠️ ใช้เฉพาะตอนรัน npm run db:migrate เท่านั้น ตัวเว็บไม่ได้ใช้
#    คำสั่งสร้างตาราง (DDL) ต้องใช้ session mode ไม่งั้นจะล้มกลางคัน
#    ไม่ต้องใส่ค่านี้ใน Vercel
DIRECT_URL="postgresql://postgres.xxxxx:รหัสผ่าน@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# เว็บไซต์ (จำเป็น)
# ------------------------------------------------------------------------------
# URL เต็มของเว็บไซต์ ใช้สร้างลิงก์ในอีเมล ลิงก์ QR และลิงก์ติดตามผล
# ตอนพัฒนาใช้ http://localhost:3000 / ตอน production ใส่โดเมนจริง
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# ความปลอดภัยและ PDPA (จำเป็นก่อนขึ้น production)
# ------------------------------------------------------------------------------
# ค่าสุ่มสำหรับแฮช IP address และรหัสผู้เข้าชม
# ระบบห้ามเก็บ IP ดิบตามข้อกำหนด PDPA จึงต้องแฮชก่อนบันทึกเสมอ
# สร้างค่าใหม่ด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ ห้ามเปลี่ยนค่านี้หลังเปิดใช้งานจริง เพราะสถิติผู้เข้าชมไม่ซ้ำจะนับใหม่ทั้งหมด
HASH_SALT=""

# ค่าสุ่มสำหรับเซ็น session ของเจ้าหน้าที่และผู้ดูแลระบบ
# สร้างค่าใหม่ด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ⚠️ ถ้าเปลี่ยนค่านี้ ทุกคนที่ล็อกอินอยู่จะหลุดออกจากระบบทันที
#    ห้ามเปลี่ยนระหว่างวันงานเด็ดขาด
SESSION_SECRET=""

# ------------------------------------------------------------------------------
# บริการส่งอีเมล (จำเป็นตั้งแต่เฟส 3)
# ------------------------------------------------------------------------------
# API key ของ Resend — สมัครที่ https://resend.com
RESEND_API_KEY=""

# ผู้ส่งอีเมล ต้องเป็นโดเมนที่ยืนยันแล้วใน Resend
# ⚠️ ต้องตั้งระเบียน SPF + DKIM + DMARC บนโดเมนให้ครบ ไม่งั้นอีเมลจะตกถัง Junk ทั้งหมด
EMAIL_FROM="TNN Event <noreply@example.com>"

# ------------------------------------------------------------------------------
# ป้องกัน bot (จำเป็นตั้งแต่เฟส 2)
# ------------------------------------------------------------------------------
# reCAPTCHA v3 — สร้างคีย์ที่ https://www.google.com/recaptcha/admin
# site key เปิดเผยได้ (ขึ้นต้นด้วย NEXT_PUBLIC_) ส่วน secret key ห้ามเปิดเผย
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# ------------------------------------------------------------------------------
# งานตามเวลา (Vercel Cron)
# ------------------------------------------------------------------------------
# ใช้ยืนยันว่าคำขอ cron มาจาก Vercel จริง ไม่ใช่คนภายนอกยิงเข้ามา
# สร้างค่าใหม่ด้วย: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ถ้าไม่ตั้ง งานกวาดที่นั่งค้างรายวันจะไม่ทำงาน (ไม่กระทบการตัดโควตาซึ่งทำแบบทันทีอยู่แล้ว)
CRON_SECRET=""

# ---------------------------------------------------------------------------
# ที่เก็บไฟล์ภาพ (Media Manager — เฟส 5)
# ต้องใส่ครบทั้ง 5 ตัวก่อน deploy ขึ้นเครื่องจริง
# ถ้าไม่ใส่ ตอนพัฒนาในเครื่องระบบจะเขียนไฟล์ลง public/uploads ให้อัตโนมัติ
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
